# Public site origin (canonical URL for metadata and sitemap)
NEXT_PUBLIC_BASE_URL=https://www.thevistassummerlin.com

# Google Maps JavaScript API + Places (amenity map on /amenities and embedded sections)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: Map ID for Advanced Markers styling
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Business Profile (NAP, embeds, reviews)
NEXT_PUBLIC_GBP_PLACE_ID=
NEXT_PUBLIC_GBP_WRITEREVIEW_URL=
NEXT_PUBLIC_GBP_REVIEWS_DISABLED=false
